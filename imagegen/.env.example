# 中转站配置 —— 复制本文件为 ~/.config/imagegen/.env 并填写（放这里技能更新/重装不会丢）
# 也可放本技能目录下的 .env（wrapper 按技能目录 > ~/.config 顺序查找）
# 各通道配置互相独立：openai 通道与 grok 通道各自的 base_url/key 分开设置

# --- openai 通道（官方 CLI fallback：gpt-image-2） ---
OPENAI_API_KEY=sk-你的中转站key
# 中转站 API 地址（必须以 /v1 结尾，SDK 在其后直接拼路径）
OPENAI_BASE_URL=https://api.你的中转站.com/v1

# --- grok 通道（grok-imagine 系） ---
# grok 专用 base_url（与 openai 各自独立；当前若同站则填相同值）
GROK_BASE_URL=https://api.你的中转站.com/v1
GROK_API_KEY=
# grok 生图模型名: 质量档(默认) grok-imagine-image-quality / 标准档 grok-imagine-image
GROK_IMAGE_MODEL=grok-imagine-image-quality
# grok 编辑模型
GROK_EDIT_MODEL=grok-imagine-edit
