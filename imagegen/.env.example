# 中转站配置 —— 复制本文件为 .env 并填写
# 你的中转站 API Key（形如 sk-xxx），在后台"API密钥"页创建
OPENAI_API_KEY=sk-你的中转站key
# 中转站 API 地址（必须以 /v1 结尾，SDK 在其后直接拼路径）
OPENAI_BASE_URL=https://api.你的中转站.com/v1
# --- grok 生图通道 ---
# grok key(同一中转站后台创建)
GROK_API_KEY=
# grok 生图模型名: 质量档(默认) grok-imagine-image-quality / 标准档 grok-imagine-image
GROK_IMAGE_MODEL=grok-imagine-image-quality
# grok 编辑模型
GROK_EDIT_MODEL=grok-imagine-edit
